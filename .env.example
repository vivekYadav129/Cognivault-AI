# ============================================================
# Cognivault AI — Production Environment Variables
# ============================================================

# Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=prod

# Server Port
PORT=8080

# PostgreSQL + pgvector Database Configuration
POSTGRES_DB=cognivault
POSTGRES_USER=cognivault
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=jdbc:postgresql://postgres:5432/cognivault
DATABASE_USERNAME=cognivault
DATABASE_PASSWORD=your_secure_postgres_password_here

# JWT Authentication (HS384/HS512 secure 64+ char random hex string)
JWT_SECRET=your_production_64_character_hex_secret_key_here_generate_with_openssl
JWT_EXPIRATION_MS=86400000

# CORS Security (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# OpenAI & RAG Engine Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=50
RAG_SIMILARITY_THRESHOLD=0.30

# File Storage Directory
UPLOAD_DIR=/app/uploads

# Frontend Configuration
VITE_API_BASE_URL=/api
